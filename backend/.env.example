# Copia este archivo como backend/.env y ajusta los valores. backend/.env no se sube a git.
# PostgreSQL 18 de Homebrew: el usuario por defecto es tu usuario de macOS, sin contraseña.
DATABASE_URL=postgresql+psycopg://TU_USUARIO@localhost:5432/retake
TEST_DATABASE_URL=postgresql+psycopg://TU_USUARIO@localhost:5432/retake_test
# development | test | production
APP_ENV=development
# Spec 003 · de dónde salen los datos: fixtures (datos de prueba) | real (las fuentes) | simulated (fuente simulada).
# En producción solo se admite real; en las pruebas automáticas nunca real.
SOURCE_MODE=fixtures
# Opcional: dirección del proxy de confianza cuya cabecera X-Forwarded-For se acepta. Déjalo vacío si no hay proxy.
TRUSTED_PROXY=
# Spec 003 · carpeta con los CSV de la Wiki que importa `uv run retake import-wiki-csv`.
# Por defecto backend/data/wiki/ (fuera de git: llevan nombres reales y fechas de nacimiento).
# WIKI_CSV_DIR=/ruta/a/la/carpeta

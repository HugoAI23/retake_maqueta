# Copia este archivo como backend/.env y ajusta los valores. backend/.env no se sube a git.
# PostgreSQL 18 de Homebrew: el usuario por defecto es tu usuario de macOS, sin contraseña.
DATABASE_URL=postgresql+psycopg://TU_USUARIO@localhost:5432/retake
TEST_DATABASE_URL=postgresql+psycopg://TU_USUARIO@localhost:5432/retake_test
# development | test | production
APP_ENV=development
